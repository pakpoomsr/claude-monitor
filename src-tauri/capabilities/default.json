{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Default capability for the main window",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "core:window:default",
    "core:window:allow-show",
    "core:window:allow-hide",
    "core:window:allow-set-focus",
    "core:event:default",
    "notification:default",
    "store:default",
    {
      "identifier": "opener:allow-open-url",
      "allow": [
        { "url": "https://github.com/sponsors/pakpoomsr" },
        { "url": "https://buymeacoffee.com/pakpoomsr" },
        { "url": "https://github.com/pakpoomsr/claude-monitor/issues" }
      ]
    }
  ]
}
